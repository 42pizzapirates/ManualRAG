# ============================================================
# 部署配置模板 —— 只入库键名，真实值一律不要提交
# 用法：在服务器上 cp .env.example .env 然后填入真实值
#       （deploy/.env 已被 gitignore 忽略）
# ============================================================

# ---------- 以下给 docker-compose.yml 用（放在服务器 /opt/rag-zhiku/.env）----------

# MinIO 管理员账号（新版镜像用 ROOT_USER/ROOT_PASSWORD，不是 ACCESS_KEY/SECRET_KEY）
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# MongoDB：root 账号仅用于初始化和管理，应用不要用它
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=RAG_zhiku

# MongoDB：应用专用账号，由 mongo-init.js 在该库内创建，只授予 readWrite
MONGO_APP_USER=
MONGO_APP_PASSWORD=

# ---------- 以下给本机项目根目录的 .env 用（应用侧连接参数）----------
# 注意：这份 .env 在【本机】，不是在服务器上

# Milvus（注意保持 http://host:port 格式）
MILVUS_URL=http://<云服务器公网IP>:19530
MILVUS_USER=root
MILVUS_PASSWORD=

# MongoDB（密码含 @ : / ? 等字符必须 URL 编码；authSource 填应用账号所在的库）
MONGO_URL=mongodb://<MONGO_APP_USER>:<URL编码后的密码>@<云服务器公网IP>:27017/?authSource=RAG_zhiku
MONGO_DB_NAME=RAG_zhiku

# MinIO（ENDPOINT 不含 scheme；SECURE 必须是精确的 True/False，写 true/1 会静默变 False）
MINIO_ENDPOINT=<云服务器公网IP>:9000
MINIO_ACCESS_KEY=<同 MINIO_ROOT_USER>
MINIO_SECRET_KEY=<同 MINIO_ROOT_PASSWORD>
MINIO_BUCKET_NAME=rag-zhiku
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False
# 图片回显基址；留空则自动回退为 http://<MINIO_ENDPOINT>
MINIO_PUBLIC_BASE_URL=
